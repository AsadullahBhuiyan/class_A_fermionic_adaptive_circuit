universe = container
container_image = /cvmfs/singularity.opensciencegrid.org/htc/pytorch:2.3.1-cuda11.8

executable = run_wrapper.sh
arguments  = slope_vs_cycle_block $(Process)

transfer_input_files = \
    run_wrapper.sh, \
    scripts/install_packages.sh, \
    scripts/run_slope_vs_cycle_block.py, \
    scripts/classA_U1FGTN_gpu.py, \
    scripts/strip_entropy_streaming_gpu.py

log    = logs/slope_vs_cycle_$(Cluster)_$(Process).log
error  = logs/slope_vs_cycle_$(Cluster)_$(Process).err
output = logs/slope_vs_cycle_$(Cluster)_$(Process).out

transfer_output_files   = output
transfer_output_remaps  = "output=results/slope_vs_cycle/job_$(Process)"

+JobDurationCategory = "Long"

gpus_minimum_capability = 8.0
gpus_maximum_capability = 8.0
gpus_minimum_memory     = 40000

request_gpus   = 1
request_cpus   = 4
request_memory = 16 GB
request_disk   = 10 GB

# 10 jobs: job 0->samples 0:10, job 1->10:20, ..., job 9->90:100
queue 10
