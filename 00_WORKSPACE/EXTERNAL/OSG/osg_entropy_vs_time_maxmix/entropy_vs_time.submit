universe = container
container_image = /cvmfs/singularity.opensciencegrid.org/htc/pytorch:2.3.1-cuda11.8

executable = run_wrapper.sh
arguments  = $(Process)

transfer_input_files = \
    run_wrapper.sh, \
    install_packages.sh, \
    params.json, \
    run_entropy_vs_time.py, \
    classA_U1FGTN_gpu.py

log    = logs/job_$(Cluster)_$(Process).log
error  = logs/job_$(Cluster)_$(Process).err
output = logs/job_$(Cluster)_$(Process).out

transfer_output_files  = output
transfer_output_remaps = "output=results/job_$(Process)"

+JobDurationCategory = "Long"

gpus_minimum_capability = 8.0
gpus_minimum_memory     = 40000

request_gpus   = 1
request_cpus   = 4
request_memory = $ENV(REQ_MEM_MB)
request_disk   = 20 GB

max_idle = $ENV(MAX_IDLE)

queue $ENV(N_JOBS)
